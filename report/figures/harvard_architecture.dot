digraph HarvardArchitecture {
  graph [rankdir=TB, bgcolor="transparent", margin=0.04, nodesep=0.22, ranksep=0.32, splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#334155", fillcolor="#F8FAFC", margin="0.12,0.07"];
  edge [fontname="Helvetica", fontsize=9, color="#475569", arrowsize=0.7];

  pc [label="Program\nCounter", fillcolor="#DBEAFE"];
  imem [label="Instruction Memory\n256 x 32-bit ROM", fillcolor="#DCFCE7"];
  core [label="Decode + Register File\nALU + Control", fillcolor="#FEF3C7"];
  dmem [label="Data Memory\n256 x 32-bit RAM", fillcolor="#DCFCE7"];
  nextpc [label="Branch / Jump\nNext-PC Logic", fillcolor="#EDE9FE"];

  pc -> imem [label="PC address"];
  imem -> core [label="32-bit instruction"];
  core -> dmem [label="address, write data, R/W"];
  dmem -> core [label="32-bit read data", constraint=false];
  core -> nextpc [label="condition + target"];
  nextpc -> pc [label="next PC", constraint=false];
}
